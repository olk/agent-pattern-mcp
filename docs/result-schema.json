{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "agent-system-design-schema",
  "title": "AgentSystemDesign",
  "description": "Agent System Design Result schema — top-level fields match src/schemas/design.py::AgentSystemDesign; definition subschemas match their respective schema classes",
  "type": "object",
  "required": ["overview", "agents"],
  "properties": {
    "overview": { "$ref": "#/definitions/AgentSystemOverview" },
    "agents": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/definitions/Agent" }
    },
    "relationships": {
      "type": "array",
      "default": [],
      "items": { "$ref": "#/definitions/Relationship" }
    },
    "quality_attributes": {
      "type": "object",
      "additionalProperties": { "type": "number" },
      "default": {}
    },
    "tool_contracts": {
      "type": "array",
      "default": [],
      "description": "Tool contracts for code generation",
      "items": { "$ref": "#/definitions/ToolContract" }
    },
    "shared_state_models": {
      "type": "array",
      "default": [],
      "description": "State models shared across agents",
      "items": { "$ref": "#/definitions/StateModel" }
    },
    "message_contracts": {
      "type": "array",
      "default": [],
      "description": "Message contracts for inter-agent communication",
      "items": { "$ref": "#/definitions/MessageContract" }
    }
  },
  "definitions": {
    "AgentSystemOverview": {
      "type": "object",
      "required": ["topology", "category", "principles"],
      "properties": {
        "topology": {
          "type": "string",
          "enum": [
            "evaluator-loop",
            "graph-orchestrated",
            "hierarchical",
            "parallel-fan-out",
            "pipeline",
            "plan-execute",
            "single-agent-loop",
            "swarm"
          ],
          "description": "Agent system topology from AgentTopology enumeration"
        },
        "category": {
          "type": "string",
          "enum": [
            "reasoning",
            "tool_use",
            "planning",
            "reflection",
            "research_synthesis",
            "multi_agent",
            "memory",
            "retrieval",
            "safety_control",
            "observability"
          ],
          "description": "Agent pattern category from PatternCategory enumeration"
        },
        "principles": { "type": "array", "items": { "type": "string" } },
        "constraints": { "type": "array", "items": { "type": "string" }, "default": [] }
      }
    },
    "Agent": {
      "type": "object",
      "required": ["id", "name", "role", "description", "responsibilities"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_-]*$",
          "description": "Unique agent identifier"
        },
        "name": { "type": "string", "minLength": 1, "maxLength": 100 },
        "role": {
          "type": "string",
          "minLength": 1,
          "description": "Agent role, e.g. 'planner', 'executor', 'critic', 'retriever'"
        },
        "description": { "type": "string", "minLength": 1 },
        "responsibilities": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string" }
        },
        "llm_role": {
          "type": "string",
          "description": "LLM config role override, e.g. 'planning', 'generation', 'reflection'"
        },
        "tools": { "type": "array", "items": { "type": "string" }, "default": [] },
        "memory": { "type": "array", "items": { "type": "string" }, "default": [] },
        "prompt_strategy": { "type": "array", "items": { "type": "string" }, "default": [] },
        "technology_stack": { "type": "array", "items": { "type": "string" }, "default": [] },
        "config_requirements": { "type": "array", "items": { "type": "string" }, "default": [] }
      }
    },
    "Relationship": {
      "type": "object",
      "required": ["source", "target", "type", "description"],
      "properties": {
        "source": { "type": "string" },
        "target": { "type": "string" },
        "type": { "type": "string" },
        "description": { "type": "string" }
      }
    },
    "ToolContract": {
      "type": "object",
      "required": ["tool_name", "agent_id"],
      "properties": {
        "tool_name": {
          "type": "string",
          "description": "Tool name, e.g. 'search', 'calculator', 'run_sql'"
        },
        "agent_id": {
          "type": "string",
          "description": "Reference to the agent that owns/exposes this tool"
        },
        "description": { "type": "string", "default": "" },
        "input_schema": {
          "type": "object",
          "description": "JSON Schema for tool input arguments",
          "additionalProperties": true
        },
        "output_schema": {
          "type": "object",
          "description": "JSON Schema for tool output",
          "additionalProperties": true
        },
        "auth_required": { "type": "boolean", "default": false }
      }
    },
    "StateModel": {
      "type": "object",
      "required": ["name"],
      "properties": {
        "name": {
          "type": "string",
          "description": "Model name, e.g. 'TaskPlan', 'ResearchNote'"
        },
        "fields": {
          "type": "array",
          "items": { "$ref": "#/definitions/StateField" },
          "default": []
        },
        "description": { "type": "string", "default": "" },
        "is_shared": { "type": "boolean", "default": false }
      }
    },
    "StateField": {
      "type": "object",
      "required": ["name", "type"],
      "properties": {
        "name": { "type": "string" },
        "type": {
          "type": "string",
          "description": "Field type (str, int, float, bool, datetime, list, dict)"
        },
        "required": { "type": "boolean", "default": true },
        "description": { "type": "string", "default": "" },
        "default": {
          "type": ["string", "number", "boolean", "null", "array", "object"]
        }
      }
    },
    "MessageContract": {
      "type": "object",
      "required": ["message_name", "payload_schema", "published_by"],
      "properties": {
        "message_name": {
          "type": "string",
          "description": "Message name, e.g. 'plan.ready', 'critique.completed'"
        },
        "payload_schema": {
          "type": "object",
          "description": "JSON Schema for message payload",
          "additionalProperties": true
        },
        "published_by": {
          "type": "string",
          "description": "Agent ID that publishes this message"
        },
        "consumed_by": {
          "type": "array",
          "items": { "type": "string" },
          "default": []
        },
        "description": { "type": "string", "default": "" }
      }
    }
  }
}
