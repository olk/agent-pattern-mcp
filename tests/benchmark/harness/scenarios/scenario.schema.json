{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Stage-0 benchmark scenario seed",
  "type": "object",
  "required": ["scenarios"],
  "additionalProperties": false,
  "properties": {
    "scenarios": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/scenario"}
    }
  },
  "$defs": {
    "scenario": {
      "type": "object",
      "required": [
        "scenario_id",
        "category",
        "split",
        "requirements",
        "domain",
        "acceptable_primary",
        "decoy_domains",
        "scripted_weights"
      ],
      "additionalProperties": false,
      "properties": {
        "scenario_id": {"type": "string", "minLength": 1},
        "category": {"type": "string", "enum": [
          "reflection",
          "observability",
          "retrieval",
          "multi_agent",
          "reasoning",
          "tool_use",
          "memory",
          "safety_control",
          "planning",
          "research_synthesis"
        ]},
        "split": {"type": "string", "enum": ["train", "holdout"]},
        "requirements": {"type": "string", "minLength": 40},
        "domain": {"type": "string", "minLength": 1},
        "acceptable_primary": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "decoy_domains": {"type": "array", "minItems": 2, "items": {"type": "string", "minLength": 1}},
        "scripted_weights": {
          "type": "object",
          "propertyNames": {"enum": [
            "reliability",
            "cost_efficiency",
            "latency",
            "output_quality",
            "observability",
            "safety",
            "simplicity"
          ]},
          "additionalProperties": {"type": "number"}
        }
      }
    }
  }
}
